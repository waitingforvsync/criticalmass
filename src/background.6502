\\ background.6502 - the screen's parts the game changes outside the plotter: the well cleared for a new
\\ game (GAME OVER's box with it), and black boxes (layout.py's). The rest of the screen is only ever the
\\ loader's (the packed screen it unpacks): plain stores, never EORed.

NextBallRow = GenNextBoxRow + 2			; the next ball's part of its box: under NEXT, to the box's end
NextBallRows = GenNextBoxRows - 2

\\ The screen for a new game: the well cleared (GAME OVER with it), and the next ball's box (the score's
\\ redrawn with the game's first frame).
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     A, X, Y: corrupted

.new_screen
{
	ZA_AUTO2 ptr						; local: the row's first byte in the well

	LDA #LO(WellAddr):STA ptr
	LDA #HI(WellAddr):STA ptr+1
	LDX #FloorRow
.row
	LDA #0:TAY
.loop
	STA (ptr),Y							; the well's 32 byte columns: 256 bytes on from its first
	INY:BNE loop
	INC ptr+1:INC ptr+1
	DEX:BNE row
	ASSERT WellColumns * 8 == 256 AND RowBytes == 512, "a row of the well is 256 bytes, of a row's 512"
	JSR draw_limit						; the limit's line (limit.6502)

	LDA #NextBallRow:LDX #NextBallRows:LDY #GenBoxCol - WellCol
	ASSERT P% == fill_box, "new_screen falls through into fill_box"
}

\\ Black out a box GenBoxCols byte columns wide, whole rows deep.
\\
\\ Inputs:
\\     A: the first row
\\     X: how many
\\     Y: the first byte column, from the well's first (D18)
\\
\\ Outputs:
\\     A, X, Y: corrupted

.fill_box
{
	ZA_AUTO2 ptr						; local: the row's box
	ZA_AUTO1 row, rows, colhi			; local: the row; rows left; the column's offset's high byte

	STA row:STX rows
	TYA:ASL A:ASL A:ASL A:STA ptr		; column * 8
	TYA:LSR A:LSR A:LSR A:LSR A:LSR A:STA colhi
.rowloop
	ASSERT RowBytes == 512, "a row is two pages"
	LDA row:ASL A:ADC colhi				; (C clear: rows are under 128)
	ADC #HI(WellAddr):STA ptr+1
	LDA #0
	LDY #GenBoxCols * 8 - 1
.byte
	STA (ptr),Y
	DEY:CPY #&FF:BNE byte
	INC row
	DEC rows:BNE rowloop
	RTS
}

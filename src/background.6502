\\ background.6502 - the screen's parts the game changes outside the plotter: the well cleared for a new
\\ game (GAME OVER's box with it), black boxes (layout.py's), and the game over's wipe. The rest of the
\\ screen is only ever the loader's (the packed screen it unpacks): plain stores, never EORed.

NextBallRow = GenNextBoxRow + 2			; the next ball's part of its box: under NEXT, to the box's end
NextBallRows = GenNextBoxRows - 2

\\ The screen for a new game: the well cleared (GAME OVER with it), and the next ball's box (the score's
\\ redrawn with the game's first frame).
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     A, X, Y: corrupted

.new_screen
{
	ZA_AUTO2 ptr						; local: the row's first byte in the well

	LDA #HI(WellAddr):STA ptr+1
	ASSERT LO(WellAddr) == 0, "the well starts a page"
	LDA #0:STA ptr:TAY
	LDX #FloorRow
.row
	STA (ptr),Y							; the well's 32 byte columns: 256 bytes on from its first
	INY:BNE row
	INC ptr+1:INC ptr+1
	DEX:BNE row
	ASSERT WellColumns * 8 == 256 AND RowBytes == 512, "a row of the well is 256 bytes, of a row's 512"
	JSR draw_limit						; the limit's line (limit.6502)

	LDA #NextBallRow:LDX #NextBallRows:LDY #GenBoxCol - WellCol
	ASSERT P% == fill_box, "new_screen falls through into fill_box"
}

\\ Black out a box GenBoxCols byte columns wide, whole rows deep.
\\
\\ Inputs:
\\     A: the first row
\\     X: how many
\\     Y: the first byte column, from the well's first (D18)
\\
\\ Outputs:
\\     A, X, Y: corrupted

.fill_box
{
	ZA_AUTO2 ptr						; local: the row's box

	STA ptr+1							; (the row, for now)
	TYA:ASL A:ASL A:ASL A:STA ptr		; column * 8 (C: its top bit)
	ASSERT RowBytes == 512, "a row is two pages"
	LDA ptr+1:ROL A						; row * 2, + that
	ADC #HI(WellAddr):STA ptr+1			; (C clear: rows are under 128)
	LDA #0
.rowloop
	LDY #GenBoxCols * 8
.byte
	DEY:STA (ptr),Y:BNE byte
	INC ptr+1:INC ptr+1
	DEX:BNE rowloop
	RTS
}

\\ The game over's wipe (D25): a row of the well, every other line cleared (its even lines: every other
\\ byte of the row's page), a row a frame from the bottom, before GAME OVER.
\\
\\ Inputs:
\\     Wipe: the rows of the well still to wipe (FloorRow at the game's end)
\\
\\ Outputs:
\\     Wipe: one fewer, the row it wiped
\\     A: Wipe, Z set once it's 0
\\     Y: corrupted

.wipe_row
{
	ZA_AUTO2 ptr						; local: the row's first byte in the well
	DEC Wipe
	LDA Wipe:ASL A:ADC #HI(WellAddr):STA ptr+1	; (C clear: Wipe < 128)
	LDY #0:STY ptr
	TYA
.loop
	STA (ptr),Y
	INY:INY:BNE loop
	LDA Wipe
	RTS
}

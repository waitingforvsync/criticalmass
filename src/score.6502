\\ score.6502 - the panel's text the game draws: the score and the best, and GAME OVER, in a 3 x 5 font
\\ with each row doubled (font.py's: only the glyphs these need), by plain stores: the panel's never
\\ EORed. The labels are in the screen the loader unpacks.

LabelCol = GenLabelCol - WellCol			; (columns from the well's first, D18)
SpaceGlyph = GenSpaceGlyph

SECTION MainVars
.Shown			SKIP 12					; each digit's cell, the score's 6 then the best's: its glyph EOR
										; SpaceGlyph (0, blank, as the loader's screen has them)
ENDSECTION

\\ Draw a glyph: its cell, two byte columns by ten lines, each of its five rows twice.
\\
\\ Inputs:
\\     A: the glyph (font.py's Order)
\\     X: the cell's left byte column, from the well's first (D18)
\\     Y: its top line
\\
\\ Outputs:
\\     A, X, Y: corrupted

.draw_glyph
{
	ZA_AUTO2 left, right				; local: the line's row's byte in the left byte column, and the right
	ZA_AUTO1 g, n						; local: the glyph; lines left

	STA g
	TXA:ASL A:ASL A:ASL A:STA left		; the column * 8 (C: its top bit)
	LDA RowHi,Y:ADC #0:STA left+1
	LDA left:ADC #8:STA right			; (C clear)
	LDA left+1:ADC #0:STA right+1
	TYA:AND #7:TAY						; the line in its row
	LDA g:ASL A:ASL A:ADC g:TAX			; its rows in the font: * 5 (C clear: a glyph's under 64)
	LDA #10:STA n
.loop
	LDA GlyphL,X:STA (left),Y			; (the font's in its colour)
	LDA GlyphR,X:STA (right),Y
	INY:CPY #8:BNE @+
	LDY #0								; the next row: 512 bytes on
	INC left+1:INC left+1:INC right+1:INC right+1
.@
	DEC n:BEQ done
	LDA n:LSR A:BCS loop				; each row twice: the next after an even count left
	INX:BNE loop						; (always)
.done
	RTS
}

\\ Draw GAME OVER in the middle of the well, in a black box (a new game clears the well).
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     A, X, Y: corrupted

.draw_game_over
{
	ZA_AUTO1 i, col						; local: the glyph; its cell's column

	LDA #GenOverBoxRow:LDX #GenOverBoxRows:LDY #GenOverBoxCol - WellCol:JSR fill_box
	LDA #GenOverCol - WellCol:STA col
	LDA #0:STA i
.loop
	LDX i:LDA OverText,X:BMI done		; (255 ends it)
	LDX col:LDY #GenOverLine
	JSR draw_glyph
	INC i
	INC col:INC col
	BNE loop							; (always)
.done
	RTS
}

\\ Draw the score and the best, if the score's changed since they were drawn: the digits whose glyphs have
\\ changed (a merge's points change the last one or two), each number's leading noughts as spaces, but for
\\ its last digit.
\\
\\ Inputs:
\\     ScoreShown: 0 if they're to be drawn
\\     Shown: the cells' glyphs
\\
\\ Outputs:
\\     ScoreShown set; Shown; A, X, Y corrupted

.draw_score
{
	ZA_AUTO1 at, col, line, started, cell	; local: the number's byte (Best + 0-5: the best's, then the
											; score's, low first); the cell's column and line; the
											; number's digits so far ORed (bit 7: its last); the cell

	LDA ScoreShown:BNE done
	INC ScoreShown
	LDX #0								; the first cell
	LDY #5								; the score's top byte
	LDA #GenScoreLine:JSR number
	LDA #GenBestLine					; (Y = 2: the best's top byte)

	\\ A number: A its line, Y its top byte, X its first cell

.number
	STA line
	LDA #LabelCol:STA col
	LDA #0:STA started
.byte
	STY at
	LDA Best,Y:LSR A:LSR A:LSR A:LSR A
	JSR digit
	LDY at
	CPY #3:BEQ last
	TYA:BNE notlast
.last
	SEC:ROR started						; its last digit: always shown
.notlast
	LDA Best,Y:AND #15
	JSR digit
	LDY at:DEY
	BIT started:BPL byte
.done
	RTS

	\\ A digit: A the digit, X its cell

.digit
	TAY
	ORA started:STA started:BNE show	; a leading nought: a space
	LDY #SpaceGlyph
.show
	TYA:EOR #SpaceGlyph
	CMP Shown,X:BEQ same				; drawn already
	STA Shown,X
	EOR #SpaceGlyph
	STX cell
	LDX col:LDY line
	JSR draw_glyph
	LDX cell
.same
	INX
	INC col:INC col
	RTS
}

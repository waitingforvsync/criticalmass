\\ sparks.6502 - the ring of particles a merge throws out (P21), as sparks.py does it, after the original's:
\\ a spark each way of 8 from the new ball's edge (sparkthrow.6502), slowing by 1/8 a frame, drifting
\\ down if gravity's on, and gone after 13 to 20 frames or on leaving the well. Each is a pixel two lines tall in the ball's
\\ colours.
\\
\\ Each frame, after the balls, every spark is EORed off with what it was EORed on with last frame, moved,
\\ and EORed on with (the byte EOR its colour) AND its pixel's mask, which it keeps. So it shows its own
\\ colour over anything, and since it's all EOR, the balls' drawing in between doesn't matter: off and on
\\ always leave the screen as the balls alone. A new spark keeps 0s, so it isn't EORed off first.
\\
\\ A spark's place is units (SparkX: from the well's left) and quarters (SparkXF), down likewise; its
\\ speed quarters of a unit a frame, signed. Each across table runs on into its down one, so one routine moves
\\ both, indexed by the slot and the slot + SparkSlots. The slots are in zero page, zeroed by the loader.

SparkSlots = GenSparkSlots

SECTION SparkSpace
.SparkX			SKIP SparkSlots			; units, from the well's left
.SparkY			SKIP SparkSlots			; and down
.SparkXF		SKIP SparkSlots			; quarters (a new spark keeps its slot's)
.SparkYF		SKIP SparkSlots
.SparkVX		SKIP SparkSlots			; quarters of a unit a frame, signed
.SparkVY		SKIP SparkSlots
.SparkLife		SKIP SparkSlots			; frames left: 0 is free
.SparkEven		SKIP SparkSlots			; its colours: its ball's bytes on even lines
.SparkOdd		SKIP SparkSlots			; and odd
.SparkKept0		SKIP SparkSlots			; what it was EORed on with, on its even line
.SparkKept1		SKIP SparkSlots			; and the odd under it
ENDSECTION
ASSERT SparkKept1 + SparkSlots == SparkZP + SparkBytes

\\ Each frame, after the balls: every live spark off, moved (a step, 7/8 of its speed kept, rounded toward
\\ 0, then gravity's quarter down if it's on), and on, the last slot first; gone when its time's up, or past a wall or
\\ the floor.
\\
\\ Inputs:
\\     the sparks' slots
\\
\\ Outputs:
\\     A, X, Y: corrupted

.update_sparks
{
	ZA_AUTO2 ptr						; local: its even line's byte
	ZA_AUTO1 mask, t					; local: its pixel; a speed / 8
	LDX #SparkSlots - 1
.slot
	LDA SparkLife,X:BEQ next
	LDA SparkKept0,X:ORA SparkKept1,X:BEQ off
	JSR at								; off
	LDY #0:LDA (ptr),Y:EOR SparkKept0,X:STA (ptr),Y
	INY:LDA (ptr),Y:EOR SparkKept1,X:STA (ptr),Y
.off
	DEC SparkLife,X:BEQ next
	JSR step							; across
	TXA:CLC:ADC #SparkSlots:TAX
	JSR step							; down
IF GenSparkGravity
	INC SparkVX,X						; (SparkVY): gravity
ENDIF
	TXA:SEC:SBC #SparkSlots:TAX
	LDA SparkX,X:BMI gone				; past a wall (past the left wraps to 128 or more)
	LDA SparkY,X:CMP #FloorLine:BCS gone	; or the floor (past the top wraps too)
	JSR at								; on
	LDA SparkX,X:LSR A:LSR A			; its pixel: the left, or the right
	LDA #&AA:BCC @+:LSR A:.@
	STA mask
	LDY #0:LDA (ptr),Y:EOR SparkEven,X:AND mask:STA SparkKept0,X:EOR (ptr),Y:STA (ptr),Y
	INY:LDA (ptr),Y:EOR SparkOdd,X:AND mask:STA SparkKept1,X:EOR (ptr),Y:STA (ptr),Y
.next
	DEX:BPL slot
	RTS
.gone
	LDA #0:STA SparkLife,X
	BEQ next

	\\ Its even line's byte (the odd's is the next: one character row).
	\\ Inputs: X, a slot. Outputs: ptr; A, Y corrupted

.at
	LDY SparkY,X:LDA RowHi,Y:STA ptr+1
	TYA:AND #6:STA ptr
	LDA SparkX,X:AND #&FC:ASL A			; its byte column * 8
	ORA ptr:STA ptr
	RTS

	\\ A step, and 7/8 of the speed kept.
	\\ Inputs: X, a slot (across) or a slot + SparkSlots (down). Outputs: A, Y, t corrupted

.step
	LDA SparkVX,X:CLC:ADC SparkXF,X:TAY	; the speed and the quarters (2r + 3 at most: gendata.py asserts it's under 128)
	AND #3:STA SparkXF,X
	TYA:CMP #&80:ROR A:CMP #&80:ROR A	; / 4, signed, rounded down
	CLC:ADC SparkX,X:STA SparkX,X
	LDA SparkVX,X:BPL @+:CLC:ADC #7:.@	; / 8, rounded toward 0
	CMP #&80:ROR A:CMP #&80:ROR A:CMP #&80:ROR A
	STA t:LDA SparkVX,X:SEC:SBC t:STA SparkVX,X
	RTS
}

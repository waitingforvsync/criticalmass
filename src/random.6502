\\ random.6502 - the random numbers (game.py's Rng), and the sizes to drop.

\\ A random byte: a 16-bit Galois LFSR (taps &B400), shifted eight times (game.py's Rng).
\\
\\ Inputs:
\\     Seed
\\
\\ Outputs:
\\     A: the byte; Seed moved on
\\     Y: corrupted

.rand
{
	LDY #8
	LDA Seed+1
.loop
	LSR A:ROR Seed
	BCC next
	EOR #&B4
.next
	DEY:BNE loop
	STA Seed+1
	LDA Seed
	RTS
}

\\ A random size to drop, 1 to GenDropSizes, evenly: a byte's low 3 bits, again while they're too big
\\ (game.py's drop_size).
\\
\\ Inputs:
\\     Seed
\\
\\ Outputs:
\\     A: the size; Seed moved on; Y corrupted

.drop_size
{
.again
	JSR rand
	AND #7:CMP #GenDropSizes:BCS again
	ADC #1								; (C clear)
	RTS
}

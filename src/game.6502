\\ game.6502 - the game around the physics, as game.py does it: the keys and the dropper, merges, critical
\\ mass, failing and the score; then each ball drawn where it should be, with hysteresis.

DropCooldown = 8						; frames: the original's 20 at 60 Hz
FailFrames = 50							; the original's 120
CriticalHold = 12						; frames the player stands still on the critical ball (the physics runs
										; on), then it bursts (D29): half a second
FailPause = 50							; frames after a burst with no failing: what it throws mustn't end the game
SlowAfter = 12							; frames of slow motion from the burst (D30)
ShedLife = 3							; frames a spark the shrinking white ball sheds lives (D31)
ShedR = 24								; and the radius its rings are thrown at (r / 2 units a frame, from r out):
										; the same each frame, so each ring is seen flying out (game.py's)
HoldWait = 50							; frames the held ball waits at most for the last drop to fall clear
ChainAge = 25							; a merge's ball made this recently (frames) chains on: its merge is the
										; chain's next link, scoring double the last (D28)
BlastLog = 394							; the blast's kick: K / d sixteenths of a unit a frame at d units, as
										; 32 log2 K (game.py's)
DropperSpeed = 1966						; 8.8 units a frame: the original's 2 px a frame
SlowSpeed = 295							; with the slow key: its 0.3 px
MaxCritical = 4
KeyLeft = 1:KeyRight = 2:KeySlow = 4:KeyDrop = 8
StateFree = 0:StateLive = 1:StateDying = 2:StateShrink = 3	; (shrink: a burst critical ball, drawn
										; shrinking away, its shape in BallGrow)
HeldSlot = MaxBalls						; the drawn records past the balls': the held ball, and the next
NextSlot = MaxBalls + 1
NextX = GenNextX						; the next ball's centre in the panel, units: under NEXT
NextY = GenNextY

SECTION MainVars
.Best			SKIP 3					; BCD, low byte first: the best score since the machine started
.Score			SKIP 3					; BCD, low byte first (after Best: draw_score reads them as one)
.Cooldown		SKIP 1					; frames until the next drop
.HoldLeft		SKIP 1					; frames the held ball may still wait for it
.Fail			SKIP 1					; frames a ball's been failing
.Over			SKIP 1					; non-zero: game over
.Freeze			SKIP 1					; frames the player still stands still on critical mass
.Calm			SKIP 1					; frames of no failing left, after a burst
.Slow			SKIP 1					; frames of slow motion left (D30): main paces them at SlowPace
.SparkTop		SKIP 1					; past the highest spark slot in use (sparks.6502)
.NumShrink		SKIP 1					; (ShrinkSlot's)
.NumCritical	SKIP 1
.ScoreShown		SKIP 1					; non-zero once the score on the screen is right
.Dying			SKIP 1					; non-zero once kill_ball has made one dying (draw_balls clears it)
NewGameZeroes = P% - Score				; (Score to here: new_game zeroes them)
.Held			SKIP 1					; the held ball's size, and the next one's
.Next			SKIP 1
.DropperX		SKIP 2					; the held ball's centre, 8.8 units
.HeldGrow		SKIP 1					; the held ball's shape as it grows in (0: hidden)
.LastDrop		SKIP 1					; the slot last dropped, while it lives (255: none)
.Released		SKIP 1					; non-zero once the drop key's been let go since a drop
.CriticalSlot	SKIP MaxCritical		; critical balls showing: they burst when the freeze is over
.ShrinkSlot		SKIP MaxCritical		; burst ones shrinking away, in the order they burst (game.py's shrinking)
.Seed			SKIP 2					; the random LFSR
.Keys			SKIP 1					; the keys down (the IRQ's)
.FrameKeys		SKIP 1					; and as this frame took them
ENDSECTION
ASSERT Score == Best + 3, "draw_score reads the score and the best as one"

\\ Start a game: no balls, the score nought, two random sizes to drop.
\\
\\ Inputs:
\\     Seed: not 0
\\
\\ Outputs:
\\     the game's state set up; A, X, Y corrupted

.new_game
{
	ASSERT StateFree == 0, "new_game's zeroes free the slots"
	LDA #0
	LDX #MaxBalls + 1
.slots
	STA BallState,X:STA DrawnShape,X
	DEX:BPL slots
	STA NumBalls:STA NumMerges
	LDX #NewGameZeroes - 1
.zeroes
	STA Score,X							; the score, cooldown, hold, fail, over, freeze, calm, slow, the
										; sparks' top, the shrinking, criticals, shown, dying
	DEX:BPL zeroes
	LDA #255:STA LastDrop
	LDA #1:STA Flash					; (the IRQ puts the palette back, in case it was mid-flash)
	STA Released
	LDA #FramePace:STA Pace
	JSR drop_size:STA Held:STA HeldGrow
	JSR drop_size:STA Next
	LDA #LO((WellLeft + WellRight) DIV 2 * 256):STA DropperX
	LDA #HI((WellLeft + WellRight) DIV 2 * 256):STA DropperX+1
	RTS
}

\\ A frame of the game: the keys, the physics, merges and failing (game.py's keys, step and after_step),
\\ then the drawing. While the player stands still on critical mass, no keys (the physics runs on); then,
\\ first thing in the frame, the burst. Slow motion's frames are counted here, and its end puts main's pace
\\ back.
\\
\\ Inputs:
\\     Keys
\\
\\ Outputs:
\\     the game moved on, and drawn; A, X, Y corrupted

.game_frame
{
	LDA Slow:BEQ update
	DEC Slow:BNE update
	LDA #FramePace:STA Pace				; slow motion's over
.update
	LDA Freeze:BEQ play
	DEC Freeze:BNE stand
	JSR do_bursts
	JMP stand
.play
	LDA Keys:STA FrameKeys				; once: the IRQ writes Keys
	JSR do_keys
.stand
	JSR physics_step
	LDA Cooldown:BEQ @+:DEC Cooldown:.@
	JSR do_merges
	JSR do_fail
	JMP draw_frame
}

\\ The frame's drawing: the balls, the sparks, then the score if it's changed.
\\
\\ Outputs:
\\     A, X, Y: corrupted

.draw_frame
{
	JSR draw_balls
	JSR update_sparks
	JMP draw_score
}

\\ The keys: move the dropper, and drop on the drop key, if it's been let go since the last drop.

.do_keys
{
	LDA FrameKeys:AND #KeySlow:BEQ fast
	LDX #LO(SlowSpeed):LDY #HI(SlowSpeed)
	ASSERT HI(SlowSpeed) <> 0, "do_keys' BNE: a speed's high byte isn't 0"
	BNE gotspeed						; (always)
.fast
	LDX #LO(DropperSpeed):LDY #HI(DropperSpeed)
.gotspeed
	\\ right first (the right limit and a move stay under 65536), so left borrows only when the two
	\\ together go past the well's left edge: the smallest ball's left limit is under a fast move

	LDA FrameKeys:AND #KeyRight:BEQ notright
	STX t:CLC:LDA DropperX:ADC t:STA DropperX
	STY t:LDA DropperX+1:ADC t:STA DropperX+1
.notright
	LDA FrameKeys:AND #KeyLeft:BEQ notleft
	STX t:SEC:LDA DropperX:SBC t:STA DropperX
	STY t:LDA DropperX+1:SBC t:STA DropperX+1
	BCS notleft
	LDA #0:STA DropperX+1				; past it: under every left limit (each over 255), so clamped
.notleft
	JSR clamp_dropper
	LDA FrameKeys:AND #KeyDrop:BEQ letgo
	LDA Released:BEQ done
	JSR drop
	BCC done
	LDA #0:STA Released
.done
	RTS
.letgo
	LDA #1:STA Released
	RTS
	ZA_AUTO1 t							; local: a byte of the speed
}

\\ Keep the dropper where the held ball fits: a unit clear of each wall.
\\
\\ Outputs:
\\     DropperX; A, Y corrupted

.clamp_dropper
{
	LDY Held
	LDA DropperX:CMP DropLoLo,Y
	LDA DropperX+1:SBC DropLoHi,Y
	BCS notlow
	LDA DropLoLo,Y:STA DropperX
	LDA DropLoHi,Y:STA DropperX+1
	RTS
.notlow
	LDA DropHiLo,Y:CMP DropperX
	LDA DropHiHi,Y:SBC DropperX+1
	BCS nothigh
	LDA DropHiLo,Y:STA DropperX
	LDA DropHiHi,Y:STA DropperX+1
.nothigh
	RTS
}

\\ Drop the held ball, if it's grown in, the cooldown's over and there's room.
\\
\\ Outputs:
\\     C: set if it dropped
\\     A, X, Y: corrupted

.drop
{
	LDA Cooldown:BNE no
	LDA HeldGrow:CMP Held:BCC no
	LDA NumBalls:CMP #MaxBalls - 10:BCS no
	JSR alloc:BCC no
	STX slot
	LDA Held:STA BallSize,X
	JSR rand:EOR &FE44:STA t			; system VIA: T1 low. A random fraction of a unit either way, so
										; drops at one place don't stack exactly balanced (T1 alone comes
										; round to four phases a frame apart: the LFSR mixes it)
	CLC:LDA DropperX:ADC t:STA BallXLo,X
	LDA t:AND #&80:BEQ @+:LDA #&FF:.@	; its sign
	ADC DropperX+1:STA BallXHi,X
	LDY Held
	LDA HeldYLo,Y:STA BallYLo,X
	LDA HeldYHi,Y:STA BallYHi,X
	LDA #255:STA BallAge,X
	JSR add_ball
	LDA slot:STA LastDrop
	LDA #HoldWait:STA HoldLeft
	LDA Next:STA Held
	JSR drop_size:STA Next
	JSR clamp_dropper
	LDA #DropCooldown:STA Cooldown
	LDA #SoundDrop:STA SoundReq
	SEC
	RTS
.no
	CLC
	RTS
	ZA_AUTO1 slot, t					; local: the new ball's slot; the fraction
}

\\ A free slot: the lowest, for a ball made now.
\\
\\ Outputs:
\\     X: the slot; C set, or clear if there's none
\\     A: corrupted

.alloc
{
	LDX #0
.loop
	LDA BallState,X:BEQ found			; (StateFree)
	INX:CPX #MaxBalls:BCC loop
	CLC
	RTS
.found
	SEC
	RTS
}

\\ Make the ball in slot X live: at rest, its pushes nought, last in Order. Its size, position and age
\\ are set already; its velocity, grow and age can be set after. Its drawn record is left: a free slot's
\\ is nothing, and a merge's ball, reusing a dying ball's slot, is drawn from where that one was.
\\
\\ Inputs:
\\     X: the slot
\\
\\ Outputs:
\\     BallRU, BallSize16: from its size (for the sweep and pair: a ball's size is set only before this)
\\     A, Y: corrupted

.add_ball
{
	LDY BallSize,X
	LDA RadiusU,Y:STA BallRU,X
	LDA Times16,Y:STA BallSize16,X
	LDA #StateLive:STA BallState,X
	LDA #0
	STA BallVXLo,X:STA BallVXHi,X:STA BallVYLo,X:STA BallVYHi,X
	STA BallIXLo,X:STA BallIXHi,X:STA BallIYLo,X:STA BallIYHi,X
	STA BallHit,X:STA BallGrow,X:STA BallLink,X
	LDY NumBalls
	TXA:STA Order,Y
	INC NumBalls
	RTS
}

\\ Take a ball out of play: out of Order, to be erased (dying) and then freed by draw_balls.
\\
\\ Inputs:
\\     X: the slot
\\
\\ Outputs:
\\     Dying set (draw_balls' scan)
\\     A, Y: corrupted; X preserved

.kill_ball
{
	LDA #StateDying:STA BallState,X:STA Dying
	CPX LastDrop:BNE notlast
	LDA #255:STA LastDrop
.notlast
	TXA
	LDY #255
.find
	INY
	CMP Order,Y:BNE find
.shift
	LDA Order+1,Y:STA Order,Y
	INY:CPY NumBalls:BCC shift
	DEC NumBalls
	RTS
}

\\ Add points to the score, BCD.
\\
\\ Inputs:
\\     add_points.points: 3 bytes, BCD, low byte first
\\
\\ Outputs:
\\     Score; ScoreShown cleared; A, X corrupted

.add_points
{
	ZA_AUTO 3, points
	SED:CLC
	LDX #0
.byte
	LDA Score,X:ADC points,X:ZA_INDEXEDBY 0..2:STA Score,X
	INX:TXA:EOR #3:BNE byte				; (INX, TXA and EOR keep the carry)
	CLD
	STA ScoreShown						; (A = 0)
	RTS
}

\\ The merges the physics found: each pair, if both still live, becomes one of the next size at their
\\ midpoint, at rest. It's a chain's next link if either was made by a merge within ChainAge frames (D28):
\\ a link past the larger of theirs, or the first. It scores its size, doubled for each link past the
\\ first. Critical mass stands the player still: do_bursts takes it from there.
\\
\\ Inputs:
\\     MergeA, MergeB, NumMerges: the pairs
\\
\\ Outputs:
\\     the balls, the score, the sound; Freeze and CriticalSlot on critical mass; A, X, Y corrupted

.do_merges
{
	ZA_AUTO1 k, slota, slotb, c, size, link	; local: the merge; the slots; the new ball's; the size; its link

	LDA #0:STA k
.loop
	LDX k:CPX NumMerges:BCC more
	LDA Freeze:CMP #CriticalHold:BNE @+	; critical mass made this frame: its rising tone (after any
	LDA #SoundRise:STA SoundReq:.@		; merge's sound; Freeze is less on the frames after)
	RTS
.more
	LDA MergeA,X:STA slota
	LDA MergeB,X:STA slotb
	INC k
	LDX slota:LDA BallState,X:CMP #StateLive:BNE loop
	LDA BallAge,X:CMP #MergeAge:BCC loop	; (a slot reused this frame by a merge's ball: age 0)
	LDX slotb:LDA BallState,X:CMP #StateLive:BNE loop
	LDA BallAge,X:CMP #MergeAge:BCC loop

	\\ the link: one past the larger of theirs, of those made this recently

	LDA #0:STA link
	JSR young							; (X: b)
	LDX slota:JSR young
	INC link
	LDX slotb:JSR kill_ball
	LDX slota:JSR kill_ball

	\\ the new ball takes a's slot (none's needed free), drawn from where a was: EOR's deltas come out
	\\ the same as a away and the new one in. It's clamped: a bigger ball at the midpoint may reach a wall

	STX c
	LDA BallSize,X:STA size
	CLC:ADC #1:STA BallSize,X
	LDY slotb
	CLC:LDA BallXLo,X:ADC BallXLo,Y:STA t
	LDA BallXHi,X:ADC BallXHi,Y
	ROR A:ROR t							; the midpoint: the 17-bit sum halved
	STA BallXHi,X:LDA t:STA BallXLo,X
	CLC:LDA BallYLo,X:ADC BallYLo,Y:STA t
	LDA BallYHi,X:ADC BallYHi,Y
	ROR A:ROR t
	STA BallYHi,X:LDA t:STA BallYLo,X
	LDA #0:STA BallAge,X
	JSR add_ball
	LDA link:STA BallLink,X
	JSR clamp_ball
	LDA #2:STA BallGrow,X				; drawn a size smaller for two frames

	\\ the score: the size, doubled for each link past the first (BCD: no carry out of the top, as the
	\\ points stay under 11,000)

	LDA size:CMP #10:BCC bcd
	ASSERT CriticalSize <= 19, "a size as BCD: 10 to 19 are + 6"
	ADC #5								; 10 and up as BCD: + 6 (C set)
.bcd
	STA add_points.points
	LDA #0:STA add_points.points+1:STA add_points.points+2
	LDY link
	SED
.double
	DEY:BEQ doubled
	CLC
	LDA add_points.points:ADC add_points.points:STA add_points.points
	LDA add_points.points+1:ADC add_points.points+1:STA add_points.points+1
	LDA add_points.points+2:ADC add_points.points+2:STA add_points.points+2
	BCC double							; (always)
.doubled
	CLD
	JSR add_points

	\\ the sound and a ring of sparks; or critical mass, shown whole and white, and the game stands still
	\\ on it (a rising tone; the burst throws the sparks)

	LDX c
	LDA BallSize,X:STA SoundParam
	CMP #CriticalSize:BEQ critical
	LDA #SoundMerge:STA SoundReq
	JSR throw_sparks
	JMP loop
.critical
	LDA #0:STA BallGrow,X
	LDA #CriticalHold:STA Freeze
	LDY NumCritical:CPY #MaxCritical:BCS full
	TXA:STA CriticalSlot,Y
	INC NumCritical
.full
	JMP loop

	\\ link = the ball's link, if it's more and the ball was made within ChainAge frames.
	\\ Inputs: X, its slot; link. Outputs: link; A corrupted

.young
	LDA BallAge,X:CMP #ChainAge:BCS old
	LDA BallLink,X:CMP link:BCC old
	STA link
.old
	RTS
	ZA_AUTO1 t							; local
}

\\ The freeze is over: each critical ball bursts (game.py's burst). It goes out of the physics, and is drawn
\\ shrinking away a shape a frame (draw_balls); every other ball is kicked away from it (blast); its
\\ pattern's pieces are thrown out, each a chain's first link; two rings of sparks fly; the bonus. Then
\\ nothing fails for a while.
\\
\\ Inputs:
\\     CriticalSlot, NumCritical: the critical balls
\\
\\ Outputs:
\\     the balls; the score; Flash, the sound, Calm, Slow and Pace; NumCritical 0; A, X, Y corrupted

.do_bursts
{
	ZA_AUTO1 k, crit, piece				; local: the entry; its ball; the pattern's piece

	LDA #0:STA k
.loop
	LDX k:CPX NumCritical:BCC more
	LDA #0:STA NumCritical
	LDA #FailPause:STA Calm
	LDA #SlowAfter:STA Slow				; slow motion (D30), main's pace from this frame
	LDA #SlowPace:STA Pace
	RTS
.more
	INC k
	LDA CriticalSlot,X:STA crit:TAX
	LDA BallState,X:CMP #StateLive:BNE loop
	JSR kill_ball
	LDA #StateShrink:STA BallState,X
	LDA #CriticalSize:STA BallGrow,X	; (draw_balls takes a shape off before each drawing)
	TXA:LDY NumShrink:STA ShrinkSlot,Y:INC NumShrink
	ASSERT CriticalHold > CriticalSize, "a burst's balls are gone before the next: ShrinkSlot's MaxCritical"
	JSR blast

	JSR rand:AND #7:TAX
	LDA PatternStart,X:STA piece
.pieces
	LDY piece
	LDA PieceSize,Y:BEQ exploded
	JSR alloc:BCC exploded
	LDY piece
	LDA PieceSize,Y:STA BallSize,X
	STX slot
	LDA PieceDX,Y:JSR halves			; the piece's place: the critical ball's, offset
	LDY crit
	CLC:ADC BallXLo,Y:STA BallXLo,X
	LDA wide:ADC BallXHi,Y:STA BallXHi,X
	LDY piece
	LDA PieceDY,Y:JSR halves
	LDY crit
	CLC:ADC BallYLo,Y:STA BallYLo,X
	LDA wide:ADC BallYHi,Y:STA BallYHi,X
	LDA #0:STA BallAge,X
	JSR add_ball
	LDA #1:STA BallLink,X				; a chain's first link
	LDY piece
	LDA PieceVX,Y:JSR eighths:STA BallVXLo,X
	LDA wide:STA BallVXHi,X
	LDA PieceVY,Y:JSR eighths:STA BallVYLo,X
	LDA wide:STA BallVYHi,X
	JSR clamp_ball
	INC piece
	JMP pieces
.exploded
	LDX crit:JSR throw_sparks			; two rings of sparks, white: from its edge, and from halfway
	LDX crit:LDA HalfHeights + CriticalSize:LSR A:JSR throw_sparks.ring
	LDA #0:STA add_points.points:STA add_points.points+2
	LDA #&10:STA add_points.points+1	; the bonus: 1,000
	JSR add_points
	LDA #FlashVsyncs:STA Flash			; (the IRQ flashes every ball white)
	LDA #SoundExplode:STA SoundReq
	JMP loop
	ZA_AUTO1 slot, wide					; local: the piece's slot; a value's high byte

	\\ A signed byte of half units, as 8.8.
	\\
	\\ Inputs:
	\\     A: the byte
	\\
	\\ Outputs:
	\\     A: the low byte; wide: the high; X, Y kept

.halves
	CMP #&80:ROR A:STA wide				; >> 1, the sign kept (C: the bit shifted out)
	LDA #0:ROR A						; << 7: that bit on top
	RTS

	\\ A signed byte of eighths of a unit, as 8.8.
	\\
	\\ Inputs:
	\\     A: the byte
	\\
	\\ Outputs:
	\\     A: the low byte; wide: the high; X, Y kept

.eighths
	PHA
	CMP #&80:ROR A:CMP #&80:ROR A:CMP #&80:ROR A
	STA wide							; >> 3, the sign kept
	PLA
	ASL A:ASL A:ASL A:ASL A:ASL A		; << 5
	RTS
}

\\ The blast: every ball in play kicked away from a critical ball's centre, K / d sixteenths of a unit a
\\ frame along the line from it, d in units (game.py's blast). It's worked as pair works its pushes,
\\ through the logs: K / d * |dx| / d is exp(log K + log |dx| - 2 log d).
\\
\\ Inputs:
\\     X: the critical ball's slot (out of Order)
\\
\\ Outputs:
\\     each ball in play's velocity; A, X, Y corrupted

.blast
{
	ZA_AUTO1 crit, k, ax, ay, sx, sy, lx, ly, sign	; local: the centre's slot; the ball's index in
										; Order; |dx|, |dy| in units; their signs (bit 7 set: plus, or 0);
										; their logs; the axis' sign
	ZA_AUTO2 base, kick					; local: log K - 2 log d; an axis' kick, 8.8, signed

	STX crit
	LDA NumBalls:STA k
.ball
	LDY k:BNE more
	RTS
.more
	DEC k
	LDX Order-1,Y
	LDY crit

	\\ |dx| and |dy|: the high bytes of the 8.8 differences, the larger less the smaller, and their signs

	LDA BallXLo,X:CMP BallXLo,Y
	LDA BallXHi,X:SBC BallXHi,Y
	BCS @+
	LDA BallXLo,Y:CMP BallXLo,X
	LDA BallXHi,Y:SBC BallXHi,X:CLC:.@
	ROR sx:STA ax
	LDA BallYLo,X:CMP BallYLo,Y
	LDA BallYHi,X:SBC BallYHi,Y
	BCS @+
	LDA BallYLo,Y:CMP BallYLo,X
	LDA BallYHi,Y:SBC BallYHi,X:CLC:.@
	ROR sy:STA ay

	\\ log d, from the logs of |dx| and |dy| (a 0 has none): the larger, and H of the difference

	LDY ax:LDA L8,Y:STA lx
	LDY ay:LDA L8,Y:STA ly
	LDA #0:STA base+1
	LDA ax:BNE xsome
	LDA ay:BEQ ball						; on the centre: no way to kick it
	LDA ly:JMP gotld
.xsome
	LDA ay:BNE both
	LDA lx:JMP gotld
.both
	LDA lx:SEC:SBC ly:BCS xlarger
	EOR #&FF:ADC #1						; (C clear) ly - lx
	TAY:LDA ly
	JMP addh
.xlarger
	TAY:LDA lx
.addh
	CLC:ADC H,Y
	BCC gotld:INC base+1
.gotld

	\\ base = log K - 2 log d

	ASL A:ROL base+1:STA base
	SEC:LDA #LO(BlastLog):SBC base:STA base
	LDA #HI(BlastLog):SBC base+1:STA base+1

	\\ each axis kicked

	LDA ax:BEQ notx
	LDA sx:STA sign
	LDA lx:JSR axis
	CLC:LDA BallVXLo,X:ADC kick:STA BallVXLo,X
	LDA BallVXHi,X:ADC kick+1:STA BallVXHi,X
.notx
	LDA ay:BEQ next
	LDA sy:STA sign
	LDA ly:JSR axis
	CLC:LDA BallVYLo,X:ADC kick:STA BallVYLo,X
	LDA BallVYHi,X:ADC kick+1:STA BallVYHi,X
.next
	JMP ball

	\\ An axis' kick: exp(base + its log) sixteenths of a unit, clamped as ExpW is (0 under 0, as 255 past
	\\ it), as 8.8, signed.
	\\ Inputs: A, the axis' log; base; sign, bit 7 set to kick the plus way. Outputs: kick; A, Y corrupted;
	\\ X kept

.axis
	CLC:ADC base:TAY
	LDA base+1:ADC #0:BMI none			; under 0: nothing
	BEQ @+:LDY #255:.@					; past 255: as 255
	LDA ExpW - GenExpWLo,Y
	LDY #0:STY kick+1
	ASL A:ROL kick+1:ASL A:ROL kick+1:ASL A:ROL kick+1:ASL A:ROL kick+1	; sixteenths, as 8.8
	BIT sign:BMI plus
	EOR #&FF:CLC:ADC #1:STA kick		; the minus way: negated
	LDA kick+1:EOR #&FF:ADC #0:STA kick+1
	RTS
.plus
	STA kick
	RTS
.none
	LDA #0:STA kick:STA kick+1
	RTS
}

\\ Keep a new piece in the well (physics.py's clamp).
\\
\\ Inputs:
\\     X: the slot
\\
\\ Outputs:
\\     A, Y: corrupted; X preserved

.clamp_ball
{
	LDY BallSize,X
	LDA BallXLo,X:CMP LeftLo,Y
	LDA BallXHi,X:SBC LeftHi,Y
	BCS notleft
	LDA LeftLo,Y:STA BallXLo,X
	LDA LeftHi,Y:STA BallXHi,X
.notleft
	LDA RightLo,Y:CMP BallXLo,X
	LDA RightHi,Y:SBC BallXHi,X
	BCS notright
	LDA RightLo,Y:STA BallXLo,X
	LDA RightHi,Y:STA BallXHi,X
.notright
	LDA BallYLo,X:CMP RadiusLo,Y
	LDA BallYHi,X:SBC RadiusHi,Y
	BCS nottop
	LDA RadiusLo,Y:STA BallYLo,X
	LDA RadiusHi,Y:STA BallYHi,X
.nottop
	LDA FloorLo,Y:CMP BallYLo,X
	LDA FloorHi,Y:SBC BallYHi,X
	BCS notfloor
	LDA FloorLo,Y:STA BallYLo,X
	LDA FloorHi,Y:STA BallYHi,X
.notfloor
	RTS
}

\\ Failing: a ball poking above the rim while touching another; for FailFrames on end, the game's over.
\\ Nothing fails while the player stands still on critical mass, nor for FailPause frames after its burst.

.do_fail
{
	LDA Freeze:BNE calm					; critical mass this frame
	LDA Calm:BEQ check					; or just after a burst: nothing fails
	DEC Calm
.calm
	LDA #0:STA Fail
	RTS
.check
	LDY NumBalls:BEQ none
.loop
	LDX Order-1,Y
	LDA BallYHi,X:CMP #RimLine + 64:BCS next	; well under the rim, whatever its size (most)
	LDA BallHit,X:BEQ next
	STY t
	LDY BallSize,X
	LDA BallYLo,X:CMP RimLo,Y			; y < the rim + r: its top's above the rim
	LDA BallYHi,X:SBC RimHi,Y
	LDY t
	BCC failing
.next
	DEY:BNE loop
.none
	LDA #0:STA Fail
	RTS
.failing
	INC Fail
	LDA Fail:CMP #FailFrames + 1:BCC notover
	LDA #1:STA Over
	LDA #0:STA Released					; RETURN must be let go before it starts another
	LDA #SoundOver:STA SoundReq
.notover
	RTS
	ZA_AUTO1 t							; local
}

\\ Draw every ball where it should be (game.py's draw): the dying away, the burst critical balls a shape
\\ smaller, each live one at its place once it's moved a pixel across or two lines down from where it was
\\ drawn, the held ball over the rim and the next in the panel.
\\
\\ Inputs:
\\     the balls, Order, NumBalls; Dying: non-zero if any are dying; ShrinkSlot, NumShrink; Held, Next,
\\     DropperX
\\
\\ Outputs:
\\     the screen; the drawn records, AnchorX/Y (the centre drawn from, less 1 and 2); Dying cleared; the
\\     dying slots freed, and the shrinking once they're gone (and out of the list); their sparks
\\     A, X, Y: corrupted

.draw_balls
{
	ZA_AUTO1 slot, shape, xu, yu		; local

	\\ the dying, away, if kill_ball made any; their slots free

	LDA Dying:BEQ shrinking
	LDA #0:STA Dying
	LDX #MaxBalls - 1
.dying
	LDA BallState,X:CMP #StateDying:BNE notdying
	STX slot
	LDA #0:STA shape
	JSR plot_slot
	LDX slot
	LDA #StateFree:STA BallState,X
.notdying
	DEX:BPL dying

	\\ the burst critical balls, in the order they burst (so their sparks take the slots the model's do):
	\\ each a shape smaller, white, about the centre it was drawn from, with a ring of short-lived sparks
	\\ (D31); at 0, away, its slot free, and out of the list

.shrinking
	LDX #0:STX keep
	LDA NumShrink:BEQ lives
.shrink
	STX each
	LDA ShrinkSlot,X:STA slot:TAX
	DEC BallGrow,X:LDA BallGrow,X
	STA shape:BEQ gone
	LDA #CriticalSize:STA colour
	LDA AnchorX,X:CLC:ADC #1:STA xu
	LDA AnchorY,X:CLC:ADC #2:STA yu
	JSR plot_slot
	LDX slot
	LDA #ShedR:LDY #ShedLife:JSR throw_sparks.lived
	LDA slot:LDX keep:STA ShrinkSlot,X	; (still shrinking: kept)
	INC keep
	JMP nextshrink
.gone
	JSR plot_slot
	LDX slot
	LDA #StateFree:STA BallState,X
.nextshrink
	LDX each:INX:CPX NumShrink:BCC shrink
	LDA keep:STA NumShrink

	\\ the live, in Order. The anchor is kept less 1 across and less 2 down, so each test is one
	\\ compare: xu - (ax - 1) under 3 is under a pixel across, and yu - (ay - 2) - 1 under 3 is under
	\\ two lines

.lives
	LDY NumBalls:BEQ held
.live
	LDX Order-1,Y
	LDA BallGrow,X:BNE growing
	LDA BallSize,X:STA shape
	CMP DrawnShape,X:BNE moved
.samecolour
	CMP DrawnColour,X:BNE moved			; (C set after: the same)
	LDA BallXHi,X:SBC AnchorX,X
	CMP #3:BCS moved
	LDA BallYHi,X:SBC AnchorY,X			; (C clear)
	CMP #3:BCS moved
	DEY:BNE live
	BEQ held							; (always)
.growing
	DEC BallGrow,X
	LDA BallSize,X:SEC:SBC #1:STA shape	; a size smaller while it grows
	CMP DrawnShape,X:BNE moved
	LDA BallSize,X:JMP samecolour
.moved
	STY index:STX slot
	LDA BallSize,X:STA colour
	LDA BallXHi,X:STA xu
	SEC:SBC #1:STA AnchorX,X
	LDA BallYHi,X:STA yu
	SEC:SBC #2:STA AnchorY,X
	JSR plot_slot
	LDY index
	DEY:BNE live

	\\ the held ball, over the rim, as it grows in

.held
	LDA #0
	LDX Over:BNE heldshape
	JSR held_shape
.heldshape
	STA shape
	LDA Held:STA colour
	LDA DropperX+1:STA xu
	LDY Held:LDA HeldYHi,Y:STA yu
	LDX #HeldSlot:STX slot
	JSR plot_slot

	\\ the next, in the panel, if it's changed (its place never does)

	LDA Next:CMP DrawnShape + NextSlot:BEQ done
	STA shape:STA colour
	LDA #NextX:STA xu
	LDA #NextY:STA yu
	LDX #NextSlot:STX slot
	JMP plot_slot
.done
	RTS

	ZA_AUTO1 index, colour, each, keep	; local: the place in Order; the colour; the shrinking list's place,
										; and how many are kept
}

\\ Draw a slot's record anew: from what's drawn to shape and colour (shape 0: nothing) at a centre.
\\
\\ Inputs:
\\     draw_balls.slot, shape, colour, xu, yu: the record and where it goes now
\\
\\ Outputs:
\\     DrawnShape and the rest updated; A, X, Y corrupted

.plot_slot
{
	LDX draw_balls.slot
	LDA DrawnShape,X:STA plot_ball.shapea
	LDA DrawnColour,X:STA plot_ball.coloura
	LDA DrawnPx,X:STA plot_ball.pxa
	LDA DrawnLine,X:STA plot_ball.linea
	LDY draw_balls.shape
	STY plot_ball.shapeb:TYA:STA DrawnShape,X
	BEQ nothing
	LDA draw_balls.colour:STA plot_ball.colourb:STA DrawnColour,X
	LDA draw_balls.xu:SEC:SBC Widths,Y	; px = (xu - W + 1) >> 1
	CLC:ADC #1:LSR A
	STA plot_ball.pxb:STA DrawnPx,X
	LDA draw_balls.yu:SEC:SBC HalfHeights,Y	; line = yu - floor(H / 2)
	STA plot_ball.lineb:STA DrawnLine,X
	JMP plot_ball
.nothing
	LDA #0:STA plot_ball.colourb:STA plot_ball.pxb:STA plot_ball.lineb
	JMP plot_ball
}

\\ The held ball's shape: hidden while the last drop's still at the rim (for HoldWait frames at most: one
\\ resting just under the rim mustn't hide it for ever, as hidden it can't be dropped), then grown in a
\\ shape a frame.
\\
\\ Outputs:
\\     A: the shape (0: hidden); HeldGrow, HoldLeft; X, Y corrupted

.held_shape
{
	LDX LastDrop:CPX #255:BEQ grow
	LDA HoldLeft:BEQ grow
	DEC HoldLeft
	LDY BallSize,X
	LDA BallYLo,X:CMP RimTwoLo,Y		; y - r < (rim + 2) units
	LDA BallYHi,X:SBC RimTwoHi,Y
	BCS grow
	LDA #0:STA HeldGrow
	RTS
.grow
	LDA HeldGrow:CMP Held:BCS full		; min(Held, HeldGrow + 1): the held size may have shrunk
	INC HeldGrow
	LDA HeldGrow
	RTS
.full
	LDA Held:STA HeldGrow
	RTS
}

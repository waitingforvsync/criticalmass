\\ sparkthrow.6502 - a merge's ring of sparks thrown (P21), and all of them off at the game's end, as
\\ sparks.py's throw and end do. Apart from sparks.6502 (the frame's), to fit the gaps the code has left.

SparkDirs = 8

\\ Throw a merge's ring: a spark each way, into the free slots from the first, while there are any. Thrown
\\ at r / 2 units a frame along an axis, 3/4 of that on the diagonals, from half that many quarters out
\\ (r, its drawn radius, along an axis), each living its direction's frames. throw_sparks.ring throws one
\\ for another r (a burst's second); throw_sparks.lived, one whose sparks live a given time (D31: the
\\ shrinking white ball's).
\\
\\ Inputs:
\\     X: the ball's slot (a merge's new one, or a burst or shrinking critical one)
\\     A (ring, lived): r
\\     Y (lived): the sparks' life, frames
\\
\\ Outputs:
\\     the sparks' slots; SparkTop, past the highest in use
\\     A, X, Y: corrupted

.throw_sparks
{
	ZA_AUTO1 xu, yu, even, odd, dir		; local: the ball's centre and colours; the direction
	ZA_AUTO1 life						; local: the sparks' life (0: their directions')
	ZA_AUTO 5, speed					; local: by a direction's code, 0, a, d, -a, -d (quarters a frame)

	LDY BallSize,X
	LDA HalfHeights,Y
.ring
	LDY #0
.lived
	STY life
	ASL A:STA speed+1					; a: 2r quarters
	LDA BallXHi,X:STA xu
	LDA BallYHi,X:STA yu
	LDY BallSize,X
	LDA ColourEven,Y:STA even
	LDA ColourOdd,Y:STA odd
	LDA speed+1
	LSR A:LSR A:EOR #&FF:SEC:ADC speed+1	; d: 3/4 of it (a + NOT a / 4 + 1)
	STA speed+2
	LDA #0:STA speed
	SBC speed+1:STA speed+3				; (C set: no borrow above)
	LDA #0:SEC:SBC speed+2:STA speed+4

	LDX #0								; the slot: the first free from here
	LDY #SparkDirs - 1
.next
	STY dir
.find
	LDA SparkLife,X:BEQ found
	INX:CPX #SparkSlots:BCC find
	RTS									; none left
.found
	CPX SparkTop:BCC @+:INX:STX SparkTop:DEX:.@	; (update_sparks looks no higher)
	LDA life:BNE @+:LDA SparkDirLife,Y:.@
	STA SparkLife,X
	LDA even:STA SparkEven,X
	LDA odd:STA SparkOdd,X
	LDA #0:STA SparkKept0,X:STA SparkKept1,X
	LDA SparkDirX,Y:TAY
	LDA speed,Y:ZA_INDEXEDBY 0..4:STA SparkVX,X
	CMP #&80:ROR A						; half the speed: its offset, units
	CLC:ADC xu:STA SparkX,X
	LDY dir
	LDA SparkDirY,Y:TAY
	LDA speed,Y:ZA_INDEXEDBY 0..4:STA SparkVY,X
	CMP #&80:ROR A
	CLC:ADC yu:STA SparkY,X
	LDY dir
	DEY:BPL next
	RTS
}

\\ The game's end: every spark off, and gone (each live one's last frame).
\\
\\ Inputs:
\\     the sparks' slots
\\
\\ Outputs:
\\     A, X, Y: corrupted

.sparks_off
{
	LDX #SparkSlots - 1
.loop
	LDA SparkLife,X:BEQ @+
	LDA #1:STA SparkLife,X:.@
	DEX:BPL loop
	JMP update_sparks
}

\\ memory.6502 - where everything lives once MASS has the machine: the zero page pool, main RAM's
\\ regions, and its pools of workspace, as virtual sections claimed where they're used.

\\   &0000  zero page: the pool, bar &FC (the MOS's IRQ entry saves A there)
\\   &0100  the stack
\\   &0200  IRQ1V at &204, and the game's variables after it (MainVars), below &287
\\   &0300  tables the loader makes (Tables)
\\   &0500  the balls (Balls, balls.6502)
\\   &0D00  an RTI, for stray NMIs (claimed from the filing system)
\\   &0E00  main RAM's code (MainCode), unpacked by the loader from MASS
\\   &4800  the screen, 64 x 28. MASS loads here: main RAM's code packed by ZX02, then the loader, which
\\          runs in place, unpacks it, and goes to main, which clears the screen (and the loader with it)

ZA_POOL &00..&FB, &FD..&FF				; &FC: the MOS's IRQ entry saves A there

MainVarsOrg = &0206						; after IRQ1V
MainVarsEnd = &0287						; below *FX247's BREAK intercept (the MOS JMPs to &287 if it's &4C)
TablesOrg = &0300
TablesEnd = &0500
BallsOrg = &0500
BallsEnd = &0D00
NmiOrg = &0D00
CodeOrg = &0E00
LoadAddr = ScreenAddr					; MASS loads into the screen's memory (MODE 7's is at &7C00, above it)

SECTION Tables, org = TablesOrg, guard = TablesEnd, virtual = TRUE
.SqLo									; v * v for v in 0..255, low and high bytes (the loader's)
	SKIP 256
.SqHi
	SKIP 256
ENDSECTION

SECTION MainVars, org = MainVarsOrg, guard = MainVarsEnd, virtual = TRUE
ENDSECTION

\\ main.6502 - the main loop: a frame every other vsync (D6, 25 fps): the keys, then the game's frame; at
\\ game over, the wipe (D25, a row a frame), GAME OVER, then RETURN (let go, then pressed) starts another.

ZA_AUTO1 frame							; the vsync count the last frame started at

SECTION MainVars
.Wipe			SKIP 1					; game over: the well's rows still to wipe (background.6502)
ENDSECTION

\\ The main loop.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none: it never returns

.main
{
	\\ the screen's drawn (the loader unpacked it): at a vsync the palette, and the display on

	LDA vsyncs
.waitvsync
	CMP vsyncs:BEQ waitvsync
	LDX #15
.palloop
	LDA Palette,X:STA &FE21				; video ULA: palette
	DEX:BPL palloop
	LDA #8:STA &FE00:LDA #&C0:STA &FE01	; CRTC R8: the display on, no cursor

	LDA &FE44:STA Seed					; system VIA: T1 low, as random as anything
	LDA &FE45:ORA #1:STA Seed+1			; (never 0)
	LDA #0:STA Best:STA Best+1:STA Best+2
	JSR sound_init
	JSR new_screen						; (the limit's line: the well's clear already)
	JSR new_game
	LDA vsyncs:STA frame
.loop
	LDA vsyncs:SEC:SBC frame
	CMP #2:BCC loop						; two vsyncs a frame
	CMP #6:BCC ontime					; a late frame's lost time is made up, but no more than a frame's
	LDA vsyncs:SEC:SBC #2:STA frame		; (after a slow patch, no racing to catch up)
.ontime
	LDA frame:CLC:ADC #2:STA frame
	LDA Over:BNE over					; (the IRQ reads the keys)
	JSR game_frame
	LDA Over:BEQ loop
	JSR sparks_off						; (the game's just ended)
	LDA #FloorRow:STA Wipe				; the wipe, a row a frame, then GAME OVER
	JMP loop

	\\ game over: the wipe, then RETURN let go, then pressed, starts another, on a clear screen

.over
	LDA Wipe:BEQ keys
	JSR wipe_row:BNE loop
	JSR draw_game_over
	JMP loop
.keys
	LDA Keys:AND #KeyDrop:BNE waitgo
	LDA #1:STA Released
	JMP loop
.waitgo
	LDA Released:BEQ loop

	\\ the best score: this game's, if it's higher (BCD compares as binary)

	LDA Best:CMP Score
	LDA Best+1:SBC Score+1
	LDA Best+2:SBC Score+2
	BCS notbest
	LDA Score:STA Best
	LDA Score+1:STA Best+1
	LDA Score+2:STA Best+2
.notbest
	JSR new_screen
	JSR new_game
	LDA #0:STA Released					; RETURN's still down: it mustn't drop the new game's first ball
	JMP loop
}

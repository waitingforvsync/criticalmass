\\ main.6502 - the main loop: a frame every Pace vsyncs (D6, 25 fps: 2; D30's slow motion, 6): the keys,
\\ then the game's frame; at game over, the wipe (D25, a row a frame), GAME OVER, then RETURN (let go, then
\\ pressed) starts another.

ZA_AUTO1 frame							; the vsync count the last frame started at

FramePace = 2							; vsyncs a frame: 25 fps
SlowPace = 6							; and in slow motion (D30)

SECTION MainVars
.Wipe			SKIP 1					; game over: the well's rows still to wipe (background.6502)
.Pace			SKIP 1					; vsyncs a frame: FramePace, or SlowPace (the game sets it)
ENDSECTION

\\ The main loop.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none: it never returns

.main
{
	\\ the screen's drawn (the loader unpacked it): at a vsync the palette, and the display on

	LDA #1:STA Flash					; (the IRQ sets the palette)
	LDA vsyncs
.waitvsync
	CMP vsyncs:BEQ waitvsync
	LDA #8:STA &FE00:LDA #&C0:STA &FE01	; CRTC R8: the display on, no cursor

	LDA &FE44:STA Seed					; system VIA: T1 low, as random as anything
	LDA &FE45:ORA #1:STA Seed+1			; (never 0)
	JSR new_screen						; (the limit's line: the well's clear already)
	JSR new_game
	LDA vsyncs:STA frame
.loop
	LDA vsyncs:SEC:SBC frame
	CMP Pace:BCC loop					; Pace vsyncs a frame
	SBC Pace:CMP #4:BCC ontime			; (C set) a late frame's lost time is made up, but no more than two
	LDA vsyncs:STA frame				; vsyncs' (after a slow patch, no racing to catch up)
	BCS go								; (always)
.ontime
	LDA frame:ADC Pace:STA frame		; (C clear)
.go
	LDA Over:BNE over					; (the IRQ reads the keys)
	JSR game_frame
	LDA Over:BEQ loop
	JSR sparks_off						; (the game's just ended)
	LDA #FloorRow:STA Wipe				; the wipe, a row a frame, then GAME OVER
	JMP loop

	\\ game over: the wipe, then RETURN let go, then pressed, starts another, on a clear screen

.over
	LDA Wipe:BEQ keys
	JSR wipe_row:BNE loop
	JSR draw_game_over
	JMP loop
.keys
	LDA Keys:AND #KeyDrop:BNE waitgo
	LDA #1:STA Released
	BNE loop							; (always)
.waitgo
	LDA Released:BEQ loop

	\\ the best score: this game's, if it's higher (BCD compares as binary)

	LDX #-3 AND &FF:SEC				; (X from -3: INX keeps the borrow)
.compare
	LDA Best - (-3 AND &FF),X:SBC Score - (-3 AND &FF),X
	INX:BNE compare
	BCS notbest
	LDX #2
.copy
	LDA Score,X:STA Best,X
	DEX:BPL copy
.notbest
	JSR new_screen
	JSR new_game
	LDA #0:STA Released					; RETURN's still down: it mustn't drop the new game's first ball
	JMP loop
}

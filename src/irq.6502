\\ irq.6502 - the interrupt: the System VIA's CA1, vsync, is its only source. It counts frames for the
\\ main loop, which runs at 25 fps (D6): an update every other vsync. It reads the keys and plays the
\\ sound (only the IRQ touches port A); it pulses the size one merge from critical mass (logical 14, P,
\\ is that size's alone) and flashes every ball white as one explodes.

ZA_AUTO1 vsyncs							; vsyncs counted, mod 256: only the IRQ writes it once running, and
										; the main loop only reads it (taking it would lose counts)

PulseOn = (CodeP << 4) OR (White EOR 7)	; the pulse's two colours, as &FE21 bytes
PulseOff = (CodeP << 4) OR (Cyan EOR 7)
FlashVsyncs = 6							; how long the explosion's flash lasts

SECTION MainVars
.Flash			SKIP 1					; vsyncs of flash left (game.6502 sets it)
ENDSECTION

\\ The IRQ1V handler. CA1 is its only source.
\\
\\ Inputs:
\\     Flash: vsyncs of the explosion's flash left
\\
\\ Outputs:
\\     vsyncs: one more; Keys: the keys down; Flash: one less
\\     A: corrupted (the MOS's entry saved it at &FC); X, Y: preserved

.irq
{
	ZA_INTERRUPT
	CLD									; (the main loop may use decimal mode)
	LDA #2:STA &FE4D					; system VIA: IFR, clear CA1
	INC vsyncs
	TXA:PHA:TYA:PHA

	\\ the keys: each key's number out on port A, its state back in bit 7 (CPY: C clear if it's down),
	\\ rolled in RETURN first, so Z ends in bit 0; then flipped

	LDA #0
FOR key = {&49, &00, &42, &61}			; RETURN (drop), SHIFT (slow), X (right), Z (left)
	LDY #key:STY &FE4F:CPY &FE4F		; system VIA: port A
	ROL A
NEXT
	EOR #&0F:STA Keys

	JSR sound_frame

	\\ the pulse: every 8 vsyncs, white or cyan

	LDA vsyncs:AND #15:BEQ pulseon
	CMP #8:BNE pulsed
	LDA #PulseOff:BNE pulse				; (always)
.pulseon
	LDA #PulseOn
.pulse
	STA &FE21							; video ULA: palette
.pulsed

	\\ the flash: every ball colour white, then the palette back

	LDA Flash:BEQ flashed
	DEC Flash:BEQ restore
	LDX #FlashBytes - 1
.whiten
	LDA flash,X:STA &FE21
	DEX:BPL whiten
	BMI flashed							; (always)
.restore
	LDX #15
.palette
	LDA Palette,X:STA &FE21
	DEX:BPL palette
.flashed
	PLA:TAY:PLA:TAX
	LDA &FC
	RTI

.flash
FOR code = {CodeR, CodeG, CodeB, CodeY, CodeM, CodeC, CodeW, CodeP}
	EQUB (code << 4) OR (White EOR 7)
NEXT
FlashBytes = P% - flash
}

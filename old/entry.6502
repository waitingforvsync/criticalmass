\\ Entry point.
\\ Anything from here on is executed once and discarded.

ALIGN &100

.entry
{
	LDX #&FF:TXS
	CLD
	CLI
	
	\\ Shut down the OS
	
	LDA &FFB7:STA 0
	LDA &FFB8:STA 1
	LDY #10
	LDA (0),Y:STA &20A:INY
	LDA (0),Y:STA &20B						; Fetch default OSBYTE vector

	LDA #16:LDX #0:JSR &FFF4				; Disable ADC
	LDA #143:LDX #12:LDY #255:JSR &FFF4		; claim NMIs
	LDA #140:LDX #0:JSR &FFF4				; select tape filing system for safety
	LDA #19:JSR &FFF4						; wait for vsync before changing CRTC

	SEI
	STX &FE4E:STX &FE6E						; disable all VIA interrupts
	STX &FE4D:STX &FE6D						; and clear all VIA flags
	STX &FE43								; keyboard write bits 0-6
	LDA #&C0:STA &FE4E						; enable System T1 interrupts
	LDA #&40:STA &FE4B:STA &FE6B			; free-run System/User T1 timer operation, T2 timed
	LDA #&0F:STA &FE42						; gain access to the addressable latch
	LDA #&03:STA &FE40						; keyboard autoscan off
	
	\\ Set up video
	
	LDX #13
	.crtcloop
	STX &FE00:LDA crtcvals,X:STA &FE01
	DEX
	BPL crtcloop
	
	\\ Set Video ULA MODE 2 and palette
	
	LDA #&F4:STA &FE20
	LDX #15
	.paletteloop
	LDA palvals,X:STA &FE21
	DEX
	BPL paletteloop	
	
	\\ Disable shadow RAM
	
	LDA #0:STA &FE34
	
	\\ Build cosine table
	
	LDA #0:TAY
	LDX #31
	SEC
	.cosineloop
	SBC #0       
	CPX #17:SBC #0:CLC
	STA costab,Y:INY
	.nextbytecos ROR cosdeltas,X:BNE cosineloop
	DEX:BPL nextbytecos
	
	\\ Build atan table
	
	LDA #0:TAY
	LDX #31
	CLC
	.atanloop
	ADC #0
	STA atantab,Y:INY
	.nextbyteatan ROR atandeltas,X:BNE atanloop
	DEX:BPL nextbyteatan

	\\ Build reciprocal table

	LDX #0                    ; denominator
	.reciploop
	STX denom+1
	LDA #1                    ; top byte of the numerator
	LDY #16                   ; because result is 16-bit
	.divloop
	ASL A:BCS subtract
	.denom CMP #0:BCC skip    ; this comes from X
	.subtract
	SBC denom+1:SEC
	.skip
	ROL reciptablo,X:ROL reciptabhi,X
	DEY:BNE divloop
	INX:BNE reciploop
	
	\\ Build multiplication tables
	
	LDA #0:TAX:TAY
	.buildmultabloop
	CLC
	.buildmultabloop2
	TYA:ADC #0
	.setmultabhi STA multabhi,X
	CMP #&40	; when X>=256, f(X)>=&4000
	TAY:TXA		; A+256*C = table index
	ROR A
	.setadd ADC #0
	STA setadd+1
	INX
	.setmultablo STA multablo,X
	BNE buildmultabloop2
	INC setmultabhi+2
	INC setmultablo+2
	INY
	BNE buildmultabloop
	
	DEY
	.buildmultabnegloop
	LDA multablo,X:STA mulnegtablo,Y
	LDA multabhi,X:STA mulnegtabhi,Y
	LDA multablo+1,X:STA mulnegtablo+&100,X
	LDA multabhi+1,X:STA mulnegtabhi+&100,X
	DEY:INX
	BNE buildmultabnegloop
	
	\\ Set up new IRQ handler
	
	LDA #LO(irq):STA &204
	LDA #HI(irq):STA &205

	\\ Sync to vsync
	
	LDA #2:STA &FE4D
	.waitforvsync
	BIT &FE4D
	BEQ waitforvsync

	; Roughly synced (to within 10 cycles)
	; Now fine tune by waiting just less than one frame
	; and check if VSync has fired. Repeat until it hasn't.
	; One frame = 312*128 = 39936 cycles
	
	.syncloop
	STA &FE4D		; 6

	LDX #209		; 2
	.outerloop
	LDY #37			; 2
	.innerloop
	DEY				; 2
	BNE innerloop	; 3/2 (innerloop = 5*37+2-1 = 186)
	DEX				; 2
	BNE outerloop	; 3/2 (outerloop = (186+2+3)*209+2-1 = 39920)

	BIT &FE4D 		; 6
	BNE syncloop 	; 3 (total = 39920+6+6+3 = 39935, one cycle less than a frame!)

	IF HI(syncloop) <> HI(P%)
	ERROR "This loop must execute within the same page"
	ENDIF

	; We are synced precisely with VSync!
	; Now we have to set up the first timer which will take us
	; to the first line of the visible screen
	
	; Latency until setting timer below
	; BNE syncloop       2
	; LDA #              2
	; STA &FE44          6
	; LDA #              2
	; STA &FE45          6
	
	; Latency from interrupt path:
	; (IRQ)              7
	; STA &FC            3
	; PLA                4
	; PHA                3
	; AND #&10           2
	; BNE *+5            2
	; JMP (&0204)        5 (CMOS 6)

	; BIT &FE4D          6 (CMOS 5)
	; BVS                3
	;
	; Total: 53
	latency = (53 + 1) DIV 2
	left_border_offset = 0
	initial_timer = ((39 - screen_vsync_pos) * 8 - screen_vsync_width) * 64 - left_border_offset - latency

	LDA #LO(initial_timer-2):STA &FE44
	LDA #HI(initial_timer-2):STA &FE45

	LDA #LO(312 * 64 - 2):STA &FE46
	LDA #HI(312 * 64 - 2):STA &FE47
	
;	CLI
	
	\\ Set up screen

	LDA #0:TAY:STA write
	LDA #HI(screen_base):STA write+1
	
	; plot checkered background
	.initscreenloop
	LDA #3:JSR plotblock4
	LDA #0:JSR plotblock8
	LDA #3:JSR plotblock4
	CPY #0:BNE initscreenloop
	INC write+1:BPL initscreenloop
	
	; clear playing area
	LDA #&10:STA write
	LDA #HI(screen_base):STA write+1
	LDA #play_height_chars:STA count
	LDA #0
	.initscreenloop2
	TAY
	TAX
	JSR plotblockX
	INC write+1
	IF play_width_chars>32
		LDX #play_width_chars*8 - 256
		JSR plotblockX
	ENDIF
	INC write+1
	DEC count
	BNE initscreenloop2
	
	; plot edges
	LDA #&08:STA write
	LDA #HI(screen_base):STA write+1
	LDA #play_height_chars:STA count
	.initscreenloop3
	LDY #0
	LDA #&15:JSR plotblock8:INC write+1
	LDY #play_width_chars*8 - 248
	LDA #&2A:JSR plotblock8:INC write+1
	DEC count
	BNE initscreenloop3
	
	; plot bottom
	LDA #LO(screen_base + play_height_chars * 512 + 8):STA write
	LDA #HI(screen_base + play_height_chars * 512 + 8):STA write+1
	LDA #&15:JSR plotstrip
	LDX #play_width_chars
	.initscreenloop4
	LDA #&3F:JSR plotstrip
	DEX:BNE initscreenloop4
	LDA #&2A:JSR plotstrip
	
	\\ Initialize zp:
	\\ Copy the sprite code down to its execution address in zp, along with some zp constants
	\\ (note we index with Y to force abs,Y mode as the code spills into page 1)
	
	LDY #0
	.zpinitloop
	LDA copiedzp,Y
	STA zpcopy_start,Y
	INY
	BNE zpinitloop
	.zpinitloop2
	LDA copiedzp+&100,Y
	STA zpcopy_start+&100,Y
	INY
	CPY #zpcopy_end-zpcopy_start-&100
	BNE zpinitloop2
	
	\\ zero initialize zp variables
	
	LDA #0
	LDX #zpclear_end-zpclear_start-1
	.zpclearloop
	STA zpclear_start,X
	DEX
	BPL zpclearloop
		
	\\ Proper start

	JMP main
	
	
	\\ Plot a solid block of 4 or 8 lines

.plotblock8
	LDX #8:BNE plotblockloop
.plotblock4
	LDX #4
.plotblockX
	.plotblockloop
	STA (write),Y
	INY:DEX
	BNE plotblockloop
	RTS
	
	\\ Plot a strip of 2 pixels followed by 2 pixels of black
	
.plotstrip
	LDY #0
	STA (write),Y:INY:STA (write),Y:INY
	LDA #&00:STA (write),Y:INY:STA (write),Y
	CLC:LDA write:ADC #8:STA write:BCC P%+4:INC write+1
	RTS
}


.crtcvals
	EQUB 127									; CRTC R0 - horizontal total
	EQUB 64										; CRTC R1 - horizontal displayed
	EQUB 91										; CRTC R2 - horizontal sync pos
	EQUB 8 + (screen_vsync_width << 4)			; CRTC R3 - sync width
	EQUB 38										; CRTC R4 - vertical total
	EQUB 0										; CRTC R5 - vertical total adjust
	EQUB screen_height							; CRTC R6 - vertical displayed
	EQUB screen_vsync_pos						; CRTC R7 - vertical sync pos
	EQUB &F0									; CRTC R8 - interlace
	EQUB 7										; CRTC R9 - scan lines per character
	EQUB 32										; CRTC R10 - cursor start
	EQUB 7										; CRTC R11 - cursor end
	EQUB HI(screen_base DIV 8)					; CRTC R12 - screen start address, hi
	EQUB LO(screen_base DIV 8)					; CRTC R13 - screen start address, lo

.palvals
	EQUB &07, &13, &26, &32, &45, &51, &64, &70
	EQUB &80, &90, &A0, &B0, &C0, &D0, &E0, &F0


k = PI/512

.cosdeltas
	FOR n, 0, 31
		a = (31-n)*8
		s0 = INT(COS((a-1)*k)*256 + 0.5)
		s1 = INT(COS((a+0)*k)*256 + 0.5)
		s2 = INT(COS((a+1)*k)*256 + 0.5)
		s3 = INT(COS((a+2)*k)*256 + 0.5)
		s4 = INT(COS((a+3)*k)*256 + 0.5)
		s5 = INT(COS((a+4)*k)*256 + 0.5)
		s6 = INT(COS((a+5)*k)*256 + 0.5)
		s7 = INT(COS((a+6)*k)*256 + 0.5)
		s8 = INT(COS((a+7)*k)*256 + 0.5)
		m = -(n<17)
		b = (s0-s1-m)*1+(s1-s2-m)*2+(s2-s3-m)*4+(s3-s4-m)*8+(s4-s5-m)*16+(s5-s6-m)*32+(s6-s7-m)*64+(s7-s8-m)*128 EOR 255
		IF n<>31
			EQUB b
		ELSE
			EQUB (b DIV 2) OR 128
		ENDIF
	NEXT
	
cos_valid = INT(ACS(255.5/256)/k+0.999)

.atandeltas
	FOR n, 0, 31
		a = (31-n)*8
		s0 = INT(ATN((a-1)/256)/k + 0.5)
		s1 = INT(ATN((a+0)/256)/k + 0.5)
		s2 = INT(ATN((a+1)/256)/k + 0.5)
		s3 = INT(ATN((a+2)/256)/k + 0.5)
		s4 = INT(ATN((a+3)/256)/k + 0.5)
		s5 = INT(ATN((a+4)/256)/k + 0.5)
		s6 = INT(ATN((a+5)/256)/k + 0.5)
		s7 = INT(ATN((a+6)/256)/k + 0.5)
		s8 = INT(ATN((a+7)/256)/k + 0.5)
		b = (s1-s0)*1+(s2-s1)*2+(s3-s2)*4+(s4-s3)*8+(s5-s4)*16+(s6-s5)*32+(s7-s6)*64+(s8-s7)*128
		IF n<>31
			EQUB b
		ELSE
			EQUB (b DIV 2) OR 128
		ENDIF
	NEXT


.copiedzp
SKIP zpcopy_end-zpcopy_start
COPYBLOCK zpcopy_start, zpcopy_end, copiedzp
.endcopiedzp